# Server Configuration
PORT=3000
NODE_ENV=development

# LLM Provider Configuration
# Set at least one provider API key below.
# Supported: GEMINI_API_KEY, OPENAI_API_KEY, or ANTHROPIC_API_KEY

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional custom model names:
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# File Upload Limits
MAX_FILE_SIZE_MB=15
